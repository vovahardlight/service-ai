# WhatsApp number in international format, digits only (example: 34600111222)
NEXT_PUBLIC_WHATSAPP_NUMBER=34123456789

# Server-only email delivery configuration (never use NEXT_PUBLIC_ for secrets or recipient addresses)
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=

# Set to the actual production origin before launch (for canonical URLs and sitemap)
NEXT_PUBLIC_SITE_URL=
